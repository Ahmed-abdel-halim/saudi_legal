APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ══════════════════════════════════════════════════════════════
# Azure Integration
# ══════════════════════════════════════════════════════════════

# ── AI / LLM ──────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Azure AI Search (Vector + Hybrid Search) ──────────────────
AZURE_SEARCH_ENDPOINT=https://YOUR-SERVICE-NAME.search.windows.net
AZURE_SEARCH_KEY=YOUR_ADMIN_API_KEY
AZURE_SEARCH_INDEX=legal-documents
# Set to true after running: php artisan azure:index-legal
AZURE_SEARCH_ENABLED=false

# ── Azure Blob Storage ─────────────────────────────────────────
AZURE_STORAGE_NAME=radiifstore
AZURE_STORAGE_KEY=YOUR_STORAGE_ACCOUNT_KEY
AZURE_STORAGE_URL=https://radiifstore.blob.core.windows.net
AZURE_CONTAINER_LEGAL=legal-data
AZURE_CONTAINER_UPLOADS=user-uploads
AZURE_CONTAINER_EXPORTS=exports

# ── Azure MySQL Flexible Server (Production) ───────────────────
AZURE_DB_HOST=radiif-mysql.mysql.database.azure.com
AZURE_DB_PORT=3306
AZURE_DB_DATABASE=radif
AZURE_DB_USERNAME=adminuser
AZURE_DB_PASSWORD=YOUR_SECURE_PASSWORD
AZURE_DB_SSL_CA=/path/to/DigiCertGlobalRootCA.crt.pem

# ── Azure App Service ─────────────────────────────────────────
AZURE_APP_NAME=radiif-app
AZURE_RESOURCE_GROUP=radiif-rg
AZURE_REGION=eastus2
